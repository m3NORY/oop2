import math


class Point3d:
    def __init__(self, x: float, y: float, z: float) -> None:
        self.x: float = x
        self.y: float = y
        self.z: float = z

    def __str__(self) -> str:
        return f"({self.x:.2f}, {self.y:.2f}, {self.z:.2f})"

    def __repr__(self) -> str:
        return f"Point3d(x={self.x:.2f}, y={self.y:.2f}, z={self.z:.2f})"

    def __eq__(self, other: "Point3d") -> bool:
        return self.x == other.x and self.y == other.y and self.z == other.z


class Vector3d:
    def __init__(self, x: float, y: float, z: float) -> None:
        self.x: float = x
        self.y: float = y
        self.z: float = z

    def __str__(self) -> str:
        return f"({self.x:.2f}, {self.y:.2f}, {self.z:.2f})"

    def __repr__(self) -> str:
        return f"Vector3d(x={self.x:.2f}, y={self.y:.2f}, z={self.z:.2f})"

    @classmethod
    def from_points(
        cls,
        start: Point3d,
        end: Point3d
    ) -> "Vector3d":
        return cls(
            end.x - start.x,
            end.y - start.y,
            end.z - start.z
        )

    def __eq__(self, other: "Vector3d") -> bool:
        return self.length() == other.length()

    def __gt__(self, other: "Vector3d") -> bool:
        return self.length() > other.length()

    def __lt__(self, other: "Vector3d") -> bool:
        return self.length() < other.length()

    def _get_vector(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        if isinstance(other, (int, float)):
            return Vector3d(other, other, other)
        return other

    def __add__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        return Vector3d(
            self.x + other.x,
            self.y + other.y,
            self.z + other.z
        )

    def __radd__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        return self + other

    def __sub__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        return Vector3d(
            self.x - other.x,
            self.y - other.y,
            self.z - other.z
        )

    def __rsub__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)
        return other - self

    def __mul__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        return Vector3d(
            self.x * other.x,
            self.y * other.y,
            self.z * other.z
        )

    def __rmul__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        return self * other

    def __truediv__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        if other.x == 0 or other.y == 0 or other.z == 0:
            raise ZeroDivisionError

        return Vector3d(
            self.x / other.x,
            self.y / other.y,
            self.z / other.z
        )

    def __rtruediv__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        if self.x == 0 or self.y == 0 or self.z == 0:
            raise ZeroDivisionError

        return Vector3d(
            other.x / self.x,
            other.y / self.y,
            other.z / self.z
        )

    def __iadd__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        self.x += other.x
        self.y += other.y
        self.z += other.z

        return self

    def __isub__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        self.x -= other.x
        self.y -= other.y
        self.z -= other.z

        return self

    def __imul__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        self.x *= other.x
        self.y *= other.y
        self.z *= other.z

        return self

    def __itruediv__(
        self,
        other: int | float | "Vector3d"
    ) -> "Vector3d":
        other = self._get_vector(other)

        if other.x == 0 or other.y == 0 or other.z == 0:
            raise ZeroDivisionError

        self.x /= other.x
        self.y /= other.y
        self.z /= other.z

        return self

    def __matmul__(self, other: "Vector3d") -> "Vector3d":
        return Vector3d(
            self.y * other.z - self.z * other.y,
            self.z * other.x - self.x * other.z,
            self.x * other.y - self.y * other.x
        )

    def length(self) -> float:
        return math.sqrt(
            self.x ** 2 +
            self.y ** 2 +
            self.z ** 2
        )

    def __len__(self) -> int:
        return int(self.length())

    def __getitem__(self, key: int | str) -> float:
        if key == 0 or key == "x":
            return self.x
        elif key == 1 or key == "y":
            return self.y
        elif key == 2 or key == "z":
            return self.z
        else:
            raise IndexError

    @staticmethod
    def is_collinear(
        a: "Vector3d",
        b: "Vector3d"
    ) -> bool:
        return (
            a.y * b.z - a.z * b.y == 0
            and a.z * b.x - a.x * b.z == 0
            and a.x * b.y - a.y * b.x == 0
        )

    @staticmethod
    def is_complanar(
        a: "Vector3d",
        b: "Vector3d",
        c: "Vector3d"
    ) -> bool:
        determinant = (
            a.x * (b.y * c.z - b.z * c.y)
            - a.y * (b.x * c.z - b.z * c.x)
            + a.z * (b.x * c.y - b.y * c.x)
        )

        return determinant == 0


