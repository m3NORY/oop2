from enum import Enum

class Color(Enum):
    RED = "\033[31m"
    GREEN = "\033[32m"
    BLUE = "\033[34m"
    YELLOW = "\033[33m"
    RESET = "\033[0m"

class Printer:
    def __init__(self, color, position, symbol="*"):
        self.color = color
        self.x = position[0]
        self.y = position[1]
        self.symbol = symbol

    def __enter__(self):
        return self

    def __exit__(self, *args):
        print(Color.RESET.value)


    @classmethod
    def print(cls, text, color, position, symbol="*"):
        x, y = position
        print(f"\033[{y};{x}H", end="")
        print(color.value + text + Color.RESET.value)

    def print_text(self, text):
        print(f"\033[{self.y};{self.x}H", end="")
        print(self.color.value + text + Color.RESET.value)

    def print_big(self, text, filename):
        font = {}

        with open(filename, "r", encoding="utf-8") as file:
            lines = file.readlines()
        i = 0
        while i < len(lines):

            if lines[i].strip() == "":
                i += 1
                continue
            letter = lines[i].strip()
            i += 1

            font[letter] = []

            while i < len(lines) and lines[i].strip() != "":
                font[letter].append(lines[i].rstrip())
                i += 1


        height = len(font[text[0].upper()])
        print(f"\033[{self.y};{self.x}H", end="")
        print(self.color.value, end="")

        for row in range(height):
            for letter in text.upper():
                if letter in font:
                    line = font[letter][row]

                    line = line.replace("#", self.symbol)

                    print(line, end="  ")

            print()

        print(Color.RESET.value)



Printer.print(
    "Привет!",
    Color.GREEN,
    (5, 2)
)


with Printer(Color.BLUE, (5, 5), "*") as printer:

    printer.print_text("Большой текст:")

    printer.print_big(
        "ABC",
        "font5.txt"
    )


with Printer(Color.RED, (5, 15), "@") as printer:

    printer.print_big(
        "ABC",
        "font5.txt"
    )



with Printer(Color.YELLOW, (5, 25), "#") as printer:

    printer.print_big(
        "ABC",
        "font7.txt"
    )
