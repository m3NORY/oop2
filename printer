def __init__(self, color, position, symbol="*"):
    self.color = color
    self.x = position[0]
    self.y = position[1]
    self.symbol = symbol

def __enter__(self):
    return self

def __exit__(self, *args):
    print(Color.RESET.value)

@classmethod
def print(cls, text, color, position, symbol="*"):
    x, y = position

    print("\n" * (y - 1), end="")
    print(" " * (x - 1), end="")
    print(color.value + text + Color.RESET.value)

def print_text(self, text):
    print("\n" * (self.y - 1), end="")
    print(" " * (self.x - 1), end="")
    print(self.color.value + text + Color.RESET.value)

def print_big(self, text, filename):

    font = {}

    with open(filename, "r", encoding="utf-8") as file:

        while True:
            line = file.readline()

            if not line:
                break

            letter = line.strip()

            if letter == "":
                continue

            font[letter] = []

            for i in range(5):
                line = file.readline()
                font[letter].append(line.rstrip("\n"))

    print("\n" * (self.y - 1), end="")

    for row in range(5):

        print(" " * (self.x - 1), end="")
        print(self.color.value, end="")

        for letter in text.upper():

            if letter in font:
                line = font[letter][row]
                line = line.replace("*", self.symbol)
                print(line, end="   ")

        print(Color.RESET.value)